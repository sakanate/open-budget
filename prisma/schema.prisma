generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         String   @id @default(uuid())
  username   String   @unique
  created_at DateTime @default(now())

  balances Balance[]
}

model Balance {
  id          String   @id @default(uuid())
  owner_id    String
  category    String
  description String
  amount      Int
  story       String?
  created_at  DateTime @default(now())

  user User @relation(fields: [owner_id], references: [id])

  @@index([owner_id])
}
